# ==============================================================================
# Pathify AI — Environment Configuration Example
# ==============================================================================
# For local development: copy this file to `.env` and adjust the values.
# For production (Render / Cloud): set these as Environment Variables in your dashboard.
# DO NOT commit the actual `.env` file containing secrets to version control.

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Local development default:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pathify_db

# Production (Render / Neon / Supabase):
# Provide the cloud connection string (e.g. postgresql://user:password@host/dbname?sslmode=require)
# The application automatically handles the postgresql+asyncpg driver prefix and ssl conversion.
# DATABASE_URL=postgresql://pathify_user:your_secure_password@dpg-xxx-a.oregon-postgres.render.com/pathify_db

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Generate a secure 64-character hex key for production (e.g., via `openssl rand -hex 32`)
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-for-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. Public Web URL & Password Reset
# ------------------------------------------------------------------------------
# The public base URL used in generated password reset links sent via email.
# Local development:
FRONTEND_URL=http://localhost:5000
# Production (Render / Custom Domain):
# FRONTEND_URL=https://pathify-ai.onrender.com

# ------------------------------------------------------------------------------
# 4. Resend Email Service (Password Reset Delivery)
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com/api-keys
# If left empty, password reset tokens will be logged in the backend console (for dev testing).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pathify AI <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 5. AI Mentor Chatbot (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API Key for dynamic AI conversational mentor responses.
# If omitted, intelligent domain-specific fallback responses are used automatically.
# GEMINI_API_KEY=
